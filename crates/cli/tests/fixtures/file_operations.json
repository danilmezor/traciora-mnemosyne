{
  "schema_version": 1,
  "scope": "P0 permanent deletion and local-trash fallback. Does not certify system-trash routing or full delete command parity.",
  "reference_version": "1.14.4",
  "reference_cli_sha256": "32e520c5c252afa2ed4dc35e7db686d4bfe41c5bf6762331742a4bd7e639645b",
  "reference_asar_sha256": "146ef8470d8cbb4a6db209bdc19bf2bad13350444186c0fd93c31087b142b92f",
  "cases": [
    {
      "id": "permanent_root",
      "reference_mode": "default",
      "initial": {
        "files": {
          "Last.md": "last note\n"
        },
        "directories": []
      },
      "steps": [
        {
          "args": [
            "delete",
            "path=Last.md",
            "permanent"
          ],
          "expected": {
            "stdout": "Deleted permanently: Last.md\n",
            "stderr": "",
            "exit_code": 0
          },
          "after": {
            "files": {},
            "directories": []
          }
        }
      ]
    },
    {
      "id": "permanent_nested",
      "reference_mode": "default",
      "initial": {
        "files": {
          "notes/deep/Only.md": "only note\n"
        },
        "directories": []
      },
      "steps": [
        {
          "args": [
            "delete",
            "path=notes/deep/Only.md",
            "permanent"
          ],
          "expected": {
            "stdout": "Deleted permanently: notes/deep/Only.md\n",
            "stderr": "",
            "exit_code": 0
          },
          "after": {
            "files": {},
            "directories": [
              "notes",
              "notes/deep"
            ]
          }
        }
      ]
    },
    {
