            ]
          }
        }
      ]
    },
    {
      "id": "trash_across_cli_processes",
      "reference_mode": "local_trash_fallback",
      "initial": {
        "files": {
          "a/Shared.md": "first\n",
          "b/Shared.md": "second\n",
          "c/Shared.md": "third\n",
          "Source.md": "[[a/Shared]] [[b/Shared]] [[c/Shared]]\n"
        },
        "directories": []
      },
      "steps": [
        {
          "args": [
            "delete",
            "path=a/Shared.md"
          ],
          "expected": {
            "stdout": "Moved to trash: a/Shared.md\n",
            "stderr": "",
            "exit_code": 0
          },
          "after": {
            "files": {
              "b/Shared.md": "second\n",
              "c/Shared.md": "third\n",
              "Source.md": "[[a/Shared]] [[b/Shared]] [[c/Shared]]\n",
              ".trash/Shared.md": "first\n"
            },
            "directories": [
              ".trash",
              "a",
              "b",
              "c"
            ]
          }
        },
        {
          "args": [
            "delete",
            "path=b/Shared.md"
          ],
          "expected": {
            "stdout": "Moved to trash: b/Shared.md\n",
            "stderr": "",
            "exit_code": 0
          },
          "after": {
            "files": {
              "c/Shared.md": "third\n",
              "Source.md": "[[a/Shared]] [[b/Shared]] [[c/Shared]]\n",
              ".trash/Shared.md": "first\n",
              ".trash/Shared 2.md": "second\n"
            },
            "directories": [
              ".trash",
              "a",
              "b",
              "c"
            ]
          }
        },
        {
          "args": [
            "delete",
            "path=c/Shared.md"
          ],
          "expected": {
            "stdout": "Moved to trash: c/Shared.md\n",
            "stderr": "",
            "exit_code": 0
          },
          "after": {
            "files": {
              "Source.md": "[[a/Shared]] [[b/Shared]] [[c/Shared]]\n",
              ".trash/Shared.md": "first\n",
              ".trash/Shared 2.md": "second\n",
              ".trash/Shared 3.md": "third\n"
            },
            "directories": [
              ".trash",
              "a",
              "b",
              "c"
            ]
          }
        }
      ]
    },
    {
