      },
      "expected": {
        "New.md": "",
        "Source.md": "---\r\nrelated: \"[[New]]\"\n---\r\n[[New]]\r\n"
      }
    },
    {
      "id": "attachment",
      "old": "image.png",
      "new": "New image.png",
      "format": "shortest",
      "files": {
        "image.png": "image",
        "Source.md": "![[image.png]] ![image.png](image.png) [[image.png|image]]\n"
      },
      "expected": {
        "Source.md": "![[New image.png]] ![New image.png](New%20image.png) [[New image.png|image]]\n",
        "New image.png": "image"
      }
